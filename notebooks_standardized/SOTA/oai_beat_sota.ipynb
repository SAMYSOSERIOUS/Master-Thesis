      },
      "source": [
        "## 4 · Stage 0 (optional) — regenerate 384px CLAHE PNGs from DICOMs\n",
        "Auto-skips if the PNGs already exist."
      ],
      "id": "Xp59nfwH10EL"
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "sryY38Xm10EL",
        "outputId": "ec1f8ee2-c766-40b0-9c09-e3d85ac71423"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "/content/drive/MyDrive/Master Thesis/oai/processed_384 -> 8547 PNGs\n",
            "Enough 384px PNGs present; skipping regeneration. (delete the folder to force a rebuild)\n"
          ]
        }
      ],
      "source": [
        "existing = len(list(PNG384.glob('*.png'))) if PNG384.exists() else 0\n",
        "print(f'{PNG384} -> {existing} PNGs')\n",
        "if existing >= 8000:\n",
        "    print('Enough 384px PNGs present; skipping regeneration. (delete the folder to force a rebuild)')\n",
        "else:\n",
        "    import pydicom\n",
        "    PNG384.mkdir(parents=True, exist_ok=True)\n",
        "    IMG_SIZE=384; PNG_SUFFIX='clahe-2.0_384px'; PREFERRED_SERIES='0.C.2'\n",
        "    clahe_proc = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))\n",
        "    def _f(ds, name, d):\n",
        "        v = getattr(ds, name, d)\n",
        "        try: return float(v)\n",
        "        except (TypeError, ValueError): return d\n",
        "    def load_dicom_array(path):\n",
        "        ds = pydicom.dcmread(str(path)); arr = ds.pixel_array.astype(np.float32)\n",
        "        arr = arr*_f(ds,'RescaleSlope',1.0) + _f(ds,'RescaleIntercept',0.0)\n",
        "        if getattr(ds,'PhotometricInterpretation','MONOCHROME2')=='MONOCHROME1': arr = arr.max()-arr\n",
        "        lo,hi = float(np.percentile(arr,1)), float(np.percentile(arr,99))\n",
        "        if hi-lo < 1: lo,hi = float(arr.min()), float(arr.max())\n",
        "        if hi-lo < 1: return np.zeros(arr.shape, dtype=np.uint8)\n",
        "        return np.clip((arr-lo)/(hi-lo)*255.0, 0, 255).astype(np.uint8)\n",
        "    def split_bilateral(arr):\n",
        "        mid = arr.shape[1]//2; return arr[:, :mid], np.fliplr(arr[:, mid:])\n",
        "    def clahe_resize(crop):\n",
        "        return np.array(Image.fromarray(clahe_proc.apply(crop),'L').resize((IMG_SIZE,IMG_SIZE), Image.LANCZOS))\n",
        "    def first_file(base):\n",
        "        try:\n",
        "            for d1 in os.scandir(base):\n",
        "                if not d1.is_dir(): continue\n",
        "                for d2 in os.scandir(d1.path):\n",
        "                    if not d2.is_dir(): continue\n",
        "                    for f in os.scandir(d2.path):\n",
        "                        if f.is_file(): return f.path\n",
        "        except OSError: return None\n",
        "        return None\n",
        "    MAP = PNG384/'_dicom_map.json'\n",
        "    if MAP.exists():\n",
        "        subject_dicoms = json.loads(MAP.read_text()); print(f'cached map: {len(subject_dicoms)} subjects')\n",
        "    else:\n",
        "        subject_dicoms = {}; t0 = time.time(); seen = 0\n",
        "        groups = [g for g in os.scandir(DICOM_DIR) if g.is_dir()]\n",
        "        total = sum(1 for g in groups for s in os.scandir(g.path) if s.is_dir())\n",
        "        print(f'scanning {total} subjects...')\n",
        "        for g in groups:\n",
        "            for subj in os.scandir(g.path):\n",
        "                if not subj.is_dir(): continue\n",
        "                seen += 1; fp = first_file(subj.path)\n",
        "                if fp: subject_dicoms.setdefault(subj.name, {})[g.name] = fp\n",
        "                if seen % 200 == 0: print(f'  {seen}/{total} | {len(subject_dicoms)} | {time.time()-t0:.0f}s', flush=True)\n",
        "        MAP.write_text(json.dumps(subject_dicoms)); print(f'scan done {time.time()-t0:.0f}s, cached.')\n",
        "    lab0 = pd.read_csv(LABELS_CSV); lab0['subject_id'] = lab0['subject_id'].astype(str)\n",
        "    def best_dicom(s):\n",
        "        mp = subject_dicoms.get(s, {}); return mp.get(PREFERRED_SERIES) or (next(iter(mp.values())) if mp else None)\n",
        "    ckj = PNG384/'_done.json'; done = set(json.loads(ckj.read_text())) if ckj.exists() else set()\n",
        "    todo = lab0[lab0['subject_id'].isin(subject_dicoms.keys())].reset_index(drop=True)\n",
        "    made = skipped = 0; t0 = time.time()\n",
        "    for k,row in todo.iterrows():\n",
        "        key = f\"{row['subject_id']}_{row['side']}\"\n",
        "        if key in done: continue\n",
        "        p = best_dicom(row['subject_id'])\n",
        "        if p is None: skipped += 1; continue\n",
        "        try:\n",
        "            arr = load_dicom_array(Path(p)); right,left = split_bilateral(arr)\n",
        "            crop = right if row['side'] in ('R','RIGHT','right',1) else left\n",
        "            Image.fromarray(clahe_resize(crop),'L').save(PNG384/f\"OAI_{row['subject_id']}_{row['side']}_{PNG_SUFFIX}.png\")\n",
        "            done.add(key); made += 1\n",
        "        except Exception as e:\n",
        "            skipped += 1\n",
        "            if skipped <= 5: print('  skip', key, str(e)[:50])\n",
        "        if (k+1) % 200 == 0: ckj.write_text(json.dumps(sorted(done))); print(f'  {k+1}/{len(todo)} made={made} skip={skipped}', flush=True)\n",
        "    ckj.write_text(json.dumps(sorted(done))); print(f'384px done: wrote {made} (skipped {skipped}).')"
      ],
      "id": "sryY38Xm10EL"
    },
