        "manifest = TM.prepare_local_data(); images = TM._IMAGES\n",
        "df = manifest[manifest['dataset']=='oai'].copy().reset_index(drop=True)\n",
        "def pid(r):\n",
        "    m = re.search(r'(\\d{5,})', str(r['filename'])); return (m.group(1) if m else str(r.name))\n",
        "df['patient_id'] = df.apply(pid, axis=1); df['orig_kl'] = df['kl_grade'].astype(int)\n",
        "print('OAI 224px:', len(df), '|', df['patient_id'].nunique(), 'patients')\n",
        "\n",
        "mk224_soft = lambda d,train: ArrayDS(d, images, train=train, strong=False, size=224)\n",
        "OOS = OUTDIR/'oos_clean.npy'\n",
        "labels = df['kl_grade'].values.astype(int)\n",
        "if OOS.exists() and np.load(OOS).shape[0] == len(df):\n",
        "    oos = np.load(OOS); print('loaded cached CleanLab OOS.')\n",
        "else:\n",
        "    groups = df['patient_id'].values; oos = np.zeros((len(df),5), dtype=np.float32)\n",
        "    freq = df['kl_grade'].value_counts().sort_index()\n",
        "    cw = (len(df)/(5.0*np.array([freq.get(k,1) for k in range(5)]))); cw = (cw/cw.mean()).tolist()\n",
        "    fq = []\n",
        "    for fi,(tri,vai) in enumerate(GroupKFold(n_splits=3).split(df, groups=groups)):\n",
        "        print(f'Cleaning fold {fi+1}/3...')\n",
        "        st,best = robust_fold(df.iloc[tri], df.iloc[vai], build_fn=lambda device: build_convnext('small',device),\n",
        "                              ds_maker=mk224_soft, class_weights=cw, epochs=14, patience=4, bs=48, lr=4e-4, device=device, log=print)\n",
        "        fq.append(best)\n",
        "        m = build_convnext('small',device); m.load_state_dict(st); oos[vai] = predict(m, mk224_soft, df.iloc[vai], device); del m; gc.collect(); torch.cuda.empty_cache()\n",
        "    print('Fold quality:', [round(q,3) for q in fq]); assert min(fq) >= 0.40\n",
        "    np.save(OOS, oos); print('saved CleanLab OOS ->', OOS)\n",
        "\n",
        "flagged = find_label_issues(labels=labels, pred_probs=oos, return_indices_ranked_by='self_confidence')\n",
        "alt = oos.argmax(1); altc = oos.max(1)\n",
        "def make_corrected(mode):\n",
        "    corrected = labels.copy()\n",
        "    if mode == 'aggressive':\n",
        "        for i in flagged: corrected[i] = alt[i]\n",
        "    else:\n",
        "        cap = {'modest':0.20}[mode]\n",
        "        ok = sorted([i for i in flagged if alt[i]!=labels[i] and altc[i]>=0.75], key=lambda i:-altc[i])[:int(cap*len(df))]\n",
        "        for i in ok: corrected[i] = alt[i]\n",
        "    return corrected\n",
        "corr = make_corrected(CLEAN_MODE); n_ch = int((corr != labels).sum())\n",
        "print(f'flagged {len(flagged)} | {CLEAN_MODE} relabels {n_ch} ({100*n_ch/len(df):.1f}%)')"
