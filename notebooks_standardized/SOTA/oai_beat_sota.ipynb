        "    w,h = img.size; ch,cw = int(h*CROP_H), int(w*CROP_W); top,left = (h-ch)//2, (w-cw)//2\n",
        "    return img.crop((left, top, left+cw, top+ch)).resize((BASE,BASE), Image.LANCZOS)\n",
        "assert PNG384.exists() and len(list(PNG384.glob('*.png'))) > 0, f'No 384px PNGs at {PNG384} — run Stage 0.'\n",
        "made = 0\n",
        "for f in sorted(PNG384.glob('*.png')):\n",
        "    out = ROIDIR/f.name\n",
        "    if out.exists(): continue\n",
        "    try: roi_crop(Image.open(f).convert('L')).save(out); made += 1\n",
        "    except Exception as e:\n",
        "        if made < 3: print('skip', f.name, str(e)[:40])\n",
        "allroi = [p for p in ROIDIR.glob('*.png') if not p.name.startswith('_')]\n",
        "print(f'ROI crops: +{made} new (dir has {len(allroi)})')\n",
        "samp = random.sample(allroi, min(12,len(allroi))); th = 200\n",
        "sheet = Image.new('L', (4*th,3*th), 30)\n",
        "for i,f in enumerate(samp): sheet.paste(Image.open(f).resize((th,th)), ((i%4)*th,(i//4)*th))\n",
        "sheet.save(ROIDIR/'_QA_montage.png'); print(f'QA montage -> {ROIDIR/\"_QA_montage.png\"}')\n",
        "\n",
        "rows = []\n",
        "for f in allroi:\n",
