        "# Preload ROI into RAM once — parallel reads (Drive I/O is latency-bound; serial was just slow, not stuck).\n",
        "from concurrent.futures import ThreadPoolExecutor\n",
        "roi = roi.reset_index(drop=True); roi['ram_idx'] = np.arange(len(roi))\n",
        "CACHE = OUTDIR/f'roi_ram_{BASE}px.npy'\n",
        "if CACHE.exists() and np.load(CACHE, mmap_mode='r').shape[0] == len(roi):\n",
        "    ROI_ARR = np.load(CACHE); print(f'loaded RAM cache {ROI_ARR.shape}')\n",
        "else:\n",
        "    paths = roi['path'].tolist(); N = len(paths)\n",
        "    ROI_ARR = np.zeros((N, BASE, BASE), dtype=np.uint8); done = 0; t0 = time.time()\n",
        "    def _load(i):\n",
        "        try:\n",
        "            a = np.asarray(Image.open(paths[i]).convert('L'))\n",
        "            if a.shape != (BASE, BASE): a = np.asarray(Image.fromarray(a).resize((BASE, BASE)))\n",
        "            return i, a\n",
        "        except Exception:\n",
        "            return i, np.zeros((BASE, BASE), np.uint8)\n",
        "    print(f'parallel-loading {N} ROI images from Drive...', flush=True)\n",
        "    with ThreadPoolExecutor(max_workers=64) as ex:\n",
        "        for i, a in ex.map(_load, range(N)):\n",
        "            ROI_ARR[i] = a; done += 1\n",
        "            if done % 500 == 0:\n",
        "                el = time.time() - t0\n",
        "                print(f'  {done}/{N}  {done/el:.0f} img/s  ~{(N-done)/max(done/el,1e-9):.0f}s left', flush=True)\n",
        "    np.save(CACHE, ROI_ARR); print(f'cached -> {CACHE}  ({time.time()-t0:.0f}s)')\n",
        "\n",
        "class RamDS(Dataset):\n",
        "    def __init__(self, df, train=False, size=RES):\n",
        "        self.idx = df['ram_idx'].values; self.y = df['kl_grade'].values\n",
        "        self.aug = (T.Compose([T.RandomHorizontalFlip(0.5), T.RandomRotation(10),\n",
        "                     T.RandomResizedCrop(size, scale=(0.85,1.0), antialias=True)]) if train\n",
        "                    else T.Compose([T.Resize((size,size), antialias=True)]))\n",
        "        self.norm = T.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])\n",
        "    def __len__(self): return len(self.idx)\n",
        "    def __getitem__(self, i):\n",
        "        x = torch.from_numpy(ROI_ARR[self.idx[i]]).float().div_(255).unsqueeze(0).repeat(3,1,1)\n",
        "        return self.norm(self.aug(x)), int(self.y[i])\n",
        "\n",
        "tr_df = roi[roi.split=='train'].copy(); va_df = roi[roi.split=='val'].copy(); te_df = roi[roi.split=='test'].copy()\n",
        "tr_df['kl_grade'] = tr_df['clean_kl'].astype(int); va_df['kl_grade'] = va_df['clean_kl'].astype(int)\n",
        "fr = pd.Series(tr_df['kl_grade']).value_counts().sort_index()\n",
        "cw = (len(tr_df)/(5.0*np.array([fr.get(k,1) for k in range(5)]))); cw = (cw/cw.mean()).tolist()\n",
        "print(f'train {len(tr_df)} | val {len(va_df)} | test {len(te_df)} | class weights {[round(x,2) for x in cw]}')\n",
        "\n",
        "mkroi = lambda d,train: RamDS(d, train=train, size=RES)\n",
        "MEMBERS = ([('convnext_base', lambda device: build_convnext('base', device), 32)] if not USE_ENSEMBLE\n",
        "           else [('convnext_base', lambda device: build_convnext('base', device), 32),\n",
        "                 ('effb5',        build_effb5, 24),\n",
        "                 ('densenet121',  build_densenet121, 64)])\n",
        "yc = te_df['clean_kl'].values.astype(int); yo = te_df['orig_kl'].values.astype(int)\n",
        "member_probs = {}\n",
        "for idx,(name,builder,bs) in enumerate(MEMBERS):\n",
        "    ck = CKPT/f'{name}_{CLEAN_MODE}.pt'\n",
        "    if ck.exists():\n",
        "        print(f'\\n[{name}] checkpoint found -> loading'); st = torch.load(ck, map_location=device)\n",
        "    else:\n",
        "        print(f'\\n=== training {name} on ROI @ {RES}px (bs={bs}), {CLEAN_MODE} labels ===')\n",
        "        st,best = train_generic(tr_df, va_df, build_fn=builder, ds_maker=mkroi, class_weights=cw,\n",
        "                                epochs=EPOCHS, patience=PATIENCE, min_epochs=MIN_EPOCHS, bs=bs, lr=LR, seed=idx, device=device, log=print)\n",
        "        torch.save(st, ck); print(f'  saved -> {ck}  (best val_acc {best:.4f})')\n",
        "    m = builder(device); m.load_state_dict(st); m.eval()\n",
        "    p = predict(m, mkroi, te_df, device, tta=True); member_probs[name] = p\n",
        "    print(f'  [{name}] test corrected {accuracy_score(yc,p.argmax(1))*100:.2f}% | original {accuracy_score(yo,p.argmax(1))*100:.2f}%')\n",
        "    del m; gc.collect(); torch.cuda.empty_cache()\n",
        "print('\\nall members done.')"
